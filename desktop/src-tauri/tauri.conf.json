{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AXIOM",
  "version": "1.0.0",
  "identifier": "app.axiom.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AXIOM",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "resources": ["bridge/axiom_bridge.py"]
  }
}
