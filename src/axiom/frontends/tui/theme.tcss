/* AXIOM theme — absolute black, deep obsidian garnet accents, ash greys.
   The garnet accent is used sparingly: active states, selection, separators.
   Design language: minimal timeline — whitespace + indentation + thin tree
   glyphs (├─ └─ │), one accent per phase, no heavy boxes. */

/* --------------------------------------------------------------- base */

/* Accent variables are supplied by the selected Textual Theme. */
Screen {
    background: #000000;
    color: #FFFFFF;
}

.no-panel-hover .action:hover {
    border: round #3A3A3A;
    color: #B9B9B9;
}
.no-panel-hover .reasoning-panel CollapsibleTitle:hover { color: #B9B9B9; }
.no-panel-hover #search-sources > ListItem:hover { background: transparent; }
.no-panel-hover #stop-button:hover { background: $secondary; }
.no-panel-hover .code-action:hover { color: #777777; background: #0A0A0A; }
.no-panel-hover #perm-once:hover { background: $secondary; }
.no-panel-hover #perm-always:hover { background: $secondary; }
.no-panel-hover #perm-deny:hover { border: round #3A3A3A; }
.no-panel-hover .profile-row:hover { background: transparent; }

/* The class is kept explicit so the configured behavior is easy to audit. */
.panel-hover #stop-button:hover,
.panel-hover .code-action:hover,
.panel-hover #perm-once:hover,
.panel-hover #perm-always:hover,
.panel-hover .profile-row:hover {
    background: $secondary;
}

/* -------------------------------------------------------------- splash */

#splash-screen {
    background: #000000;
}

#splash-body {
    width: 1fr;
    height: 1fr;
    align: center middle;
}

#splash-column {
    width: 64;
    height: auto;
    padding: 0 2;
}

#splash-hole {
    width: 46;
    height: 19;
    margin-left: 4;
}

#splash-progress {
    width: auto;
    height: 1;
    margin-bottom: 1;
}

#splash-message.ready {
    color: #ff9a6a;
}

#splash-logo {
    color: #FFFFFF;
    text-style: bold;
}

#splash-rule {
    color: $accent;
    margin-top: 1;
}

#splash-subtitle {
    color: #777777;
    margin-bottom: 1;
}

#splash-steps {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
}

.splash-step {
    color: #B9B9B9;
}

.splash-step.failed {
    color: #8E3038;
}

#splash-message {
    color: #777777;
    margin-bottom: 1;
}

#splash-message.failed {
    color: #8E3038;
    text-style: bold;
}

#splash-actions {
    height: auto;
    content-align: center middle;
}

.action {
    margin: 0 2;
    padding: 0 2;
    border: round #3A3A3A;
    color: #B9B9B9;
}

.action:hover {
    border: round $accent;
    color: #FFFFFF;
}

.action.selected {
    border: tall $accent;
    color: #FFFFFF;
    background: $secondary;
}

/* -------------------------------------------------------------- header */

HeaderBar {
    height: 1;
    background: #050505;
    padding: 0 2;
}

#header-brand {
    width: auto;
    color: #FFFFFF;
    text-style: bold;
}

#header-model {
    width: 1fr;
    padding-left: 2;
    color: #FFFFFF;
}

#header-connection {
    width: auto;
    color: #7E9E86;
}

#header-connection.offline {
    color: #8E3038;
}

/* ----------------------------------------------------------- chat view */

#chat-view {
    height: 1fr;
    background: #000000;
    padding: 1 3;
    scrollbar-size: 1 1;
}

#follow-hint {
    width: 1fr;
    height: 1;
    color: #777777;
    background: #161616;
    padding: 0 1;
}

#find-bar {
    dock: bottom;
    height: 3;
    width: 1fr;
    background: #080808;
    border-top: solid $secondary;
    padding: 0 2;
}

#find-label {
    width: auto;
    color: $accent;
    padding: 1 1 0 0;
}

#find-input {
    width: 1fr;
    height: 3;
    border: none;
    background: #080808;
    color: #FFFFFF;
}

#find-count {
    width: 14;
    color: #777777;
    content-align: right middle;
    padding-top: 1;
}

#orchestration-timeline,
.benchmark-row {
    color: #B9B9B9;
    margin: 0 1;
    padding: 0 1;
}

#orchestration-timeline {
    color: #D0D0D0;
}

.message {
    height: auto;
    margin-bottom: 1;
    padding-bottom: 1;
}

.role-label {
    width: 1fr;
    height: auto;
    color: #4A4642;
    text-style: bold;
}

.user-message {
    margin-bottom: 1;
    border-bottom: solid #161616;
    padding-bottom: 1;
}

.user-message .role-label {
    color: #777777;
}

.user-message .message-body {
    color: #FFFFFF;
    margin: 0 0 0 2;
    padding-left: 2;
    border-left: solid #3A3A3A;
}

.assistant-message .role-label {
    color: #FFFFFF;
    text-style: bold;
}

.assistant-status {
    height: auto;
    color: #B9B9B9;
    margin: 0 0 1 2;
}

.phase-title {
    color: #FFFFFF;
    text-style: bold;
    margin: 1 0 0 2;
}

.phase-note {
    color: #4A4642;
    margin: 0 0 0 2;
}

.tool-line {
    height: auto;
    color: #B9B9B9;
    margin: 1 0 0 2;
}

.block-label {
    color: #FFFFFF;
    text-style: bold;
    margin: 1 0 0 2;
}

#answer-markdown {
    height: auto;
    margin: 0 0 0 4;
    color: #EDEDED;
}

.metrics-footer {
    color: #777777;
    margin: 1 0 1 2;
}

.error-box {
    border-left: thick #8E3038;
    background: #161616;
    color: #FFFFFF;
    margin: 1 0 1 2;
    padding: 0 2;
}

.message-note {
    color: #777777;
    margin: 0 0 1 4;
}

/* ----------------------------------------------------------- reasoning */

.reasoning-panel {
    height: auto;
    margin: 0 0 1 2;
}

.reasoning-panel Collapsible {
    height: auto;
    background: transparent;
    border: none;
    padding: 0;
}

.reasoning-panel CollapsibleTitle {
    color: #B9B9B9;
}

.reasoning-panel CollapsibleTitle:hover {
    color: #FFFFFF;
}

#reasoning-text {
    color: #8A8A8A;
    padding-left: 2;
    border-left: solid #262626;
}

/* -------------------------------------------------------------- search */

.search-panel {
    height: auto;
    margin: 1 0 1 2;
    border: none;
    padding-left: 0;
}

#search-steps {
    color: #B9B9B9;
    margin-left: 2;
}

#search-sources {
    height: auto;
    max-height: 10;
    background: transparent;
    margin-left: 2;
}

#search-sources > ListItem {
    background: transparent;
    height: auto;
    padding: 0 1;
}

#search-sources > ListItem:hover {
    background: #161616;
}

.source-title {
    color: #FFFFFF;
}

.source-url {
    color: #777777;
}

/* -------------------------------------------------------------- prompt */

InputBar {
    height: auto;
    background: #050505;
    border-top: solid #1A1A1A;
}

#prompt-row {
    height: auto;
    padding: 1 1 0 1;
}

#prompt-glyph {
    width: auto;
    color: #FFFFFF;
    text-style: bold;
    padding: 0 1;
}

#prompt-glyph.busy {
    color: #8E3038;
}

#prompt-input {
    height: auto;
    max-height: 8;
    background: transparent;
    border: none;
    padding: 0 1;
}

#stop-button {
    width: auto;
    color: #FFFFFF;
    background: $secondary;
    border: round $accent;
    padding: 0 2;
    margin: 0 1;
    text-align: center;
}

#stop-button:hover {
    background: $secondary;
}

#input-hint {
    height: 1;
    color: #4A4642;
    padding: 0 2;
}

/* ------------------------------------------------------- command menu */

#command-menu {
    height: auto;
    max-height: 18;
    margin: 0 1;
    border: round $secondary;
    background: #080808;
}

#command-menu-title {
    color: $accent;
    text-style: bold;
    padding: 0 1;
}

#command-menu-list {
    height: auto;
    max-height: 16;
    background: transparent;
    padding: 0 1;
}

/* ---------------------------------------------------------- status bar */

#status-bar {
    height: 1;
    background: #050505;
    color: #777777;
    padding: 0 2;
}

/* -------------------------------------------------------------- panels */

PanelScreen {
    align: center middle;
}

.panel {
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 84%;
    border: round $secondary;
    background: #080808;
    padding: 1 2;
}

.panel-subtitle {
    color: #777777;
    margin-bottom: 1;
}

#panel-body {
    height: auto;
    max-height: 26;
}

.panel-note {
    color: #777777;
    margin-top: 1;
}

#model-list,
#history-list,
#help-list {
    height: auto;
    max-height: 20;
    background: transparent;
}

.settings-row {
    height: auto;
    margin-bottom: 1;
}

.settings-label {
    width: 1fr;
    color: #B9B9B9;
}

#temperature-input {
    width: 20;
    background: #161616;
}

#system-prompt-input {
    height: 6;
    background: #161616;
    border: round #262626;
}

#save-settings {
    width: auto;
    margin-top: 1;
    background: $secondary;
    border: round $accent;
    color: #FFFFFF;
}

.status-row {
    height: auto;
}

.status-key {
    width: 20;
    color: #777777;
}

.status-value {
    width: 1fr;
    color: #FFFFFF;
}

/* --------------------------------------------------------- responsiveness */

/* Textual 8 does not support @media queries: adapt through relative units.
   The panel fills most of any terminal, paddings stay small on narrow ones. */

.panel {
    width: 90%;
    min-width: 46;
}

#chat-view {
    padding: 1 1;
}

.user-message .message-body,
.assistant-status,
.block-label,
.metrics-footer,
.error-box,
.message-note {
    margin-left: 1;
}

#answer-markdown {
    margin-left: 2;
}

.reasoning-panel,
.search-panel {
    margin-left: 1;
}

/* -------------------------------------------------------- code-action buttons */

#code-actions {
    height: auto;
    margin: 0 0 0 2;
    padding: 0;
}

.code-action {
    width: auto;
    color: #777777;
    background: #0A0A0A;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}

.code-action:hover {
    color: #FFFFFF;
    background: $secondary;
}

/* -------------------------------------------------------- permission dialog */

#perm-overlay {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
}

#perm-dialog {
    width: 52;
    height: auto;
    border: round $accent;
    background: #080808;
    padding: 1 2;
    align: center middle;
    margin: 6 0 0 0;
}

#perm-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#perm-tool {
    color: #FFFFFF;
    margin-bottom: 1;
}

#perm-args {
    color: #B9B9B9;
    margin: 0 0 1 2;
}

#perm-prompt {
    color: #FFFFFF;
    margin-bottom: 1;
}

#perm-buttons {
    height: auto;
    align: center middle;
}

#perm-once {
    width: 14;
    margin-right: 2;
    background: $secondary;
    border: round $accent;
    color: #FFFFFF;
}

#perm-once:hover {
    background: $secondary;
}

#perm-always {
    width: 16;
    margin-right: 2;
    background: #161616;
    border: round $accent;
    color: #FFFFFF;
}

#perm-always:hover {
    background: $secondary;
}

#perm-deny {
    width: 10;
    background: #161616;
    border: round #3A3A3A;
    color: #8E3038;
}

#perm-deny:hover {
    border: round #8E3038;
}

/* --------------------------------------------------------- profile panel */

#profile-list {
    height: auto;
    max-height: 20;
    background: transparent;
}

#profile-current {
    color: #777777;
    margin-bottom: 1;
}

.profile-row {
    height: auto;
    margin-bottom: 0;
}

.profile-row:hover {
    background: $secondary;
}

.profile-row.selected {
    background: $secondary;
    color: #FFFFFF;
}

.profile-name {
    width: 1fr;
    color: #FFFFFF;
    text-style: bold;
}

.profile-glyph {
    width: auto;
    color: $accent;
    margin-right: 1;
}

.profile-prompt-preview {
    color: #777777;
    margin: 0 0 0 4;
}

/* --------------------------------------------------------- plugin info panel */

.plugin-info-summary {
    color: #B9B9B9;
    padding: 1;
    margin-bottom: 1;
}

.plugin-info-readme {
    color: #777777;
    padding: 1;
    border: round #3A3A3A;
    background: #050505;
}

/* ------------------------------------------------- workspace side panel */

#workspace-body {
    height: 1fr;
}

#workspace-main {
    width: 1fr;
    height: 1fr;
}

#activity-panel {
    width: 38;
    height: 1fr;
    background: #050505;
    border-left: solid #1A1A1A;
    padding: 0 0 1 0;
}

#activity-title {
    height: 1;
    background: #0b0b0d;
    margin-bottom: 1;
}

#activity-tree {
    height: 1fr;
    min-height: 6;
    background: transparent;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

.activity-head {
    height: 1;
    margin-top: 1;
    background: #0b0b0d;
}

#activity-files {
    text-wrap: nowrap;
    text-overflow: ellipsis;
    height: auto;
    max-height: 11;
    color: #777777;
    padding: 0 0;
}

#activity-log {
    height: auto;
    max-height: 15;
    color: #777777;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.activity-empty {
    color: #6c6c78;
    height: auto;
    padding: 0 1;
}

/* ---------------------------------------------------- rich tool blocks */

.tool-block {
    height: auto;
    margin: 0 0 0 1;
    padding: 0 1;
    border-left: tall #26262c;
}

.tool-block.failed {
    border-left: tall #8E3038;
}

/* ----------------------------------------------------------- folder picker */

#folder-picker { align: center middle; }
#folder-frame { width: 110; max-width: 96%; height: 34; max-height: 92%; }
#folder-path-row { height: 3; margin: 1 0 0 0; }
#folder-path { width: 1fr; }
#folder-up { width: 8; min-width: 8; margin-left: 1; }
#folder-body { height: 1fr; margin-top: 1; }
#folder-side { width: 26; border-right: tall #24242c; }
#folder-places { height: 1fr; border: none; background: transparent; }
.folder-head { color: #6c6c78; height: 1; }
#folder-tree { width: 1fr; height: 1fr; background: transparent; padding-left: 1; }
#folder-info { height: 2; padding-top: 1; }
#folder-actions { height: 3; align-horizontal: right; }
#folder-actions Button { margin-left: 1; }

/* side panel additions */
#activity-tree-host { height: 1fr; }
.activity-path { height: 1; }
#activity-empty { height: auto; }

/* ----------------------------------------------------------- account */

#account-screen { align: center middle; }
#account-frame { width: 92; max-width: 96%; height: 44; max-height: 94%; }
#account-body { height: 1fr; }
#account-status { height: 1; }
.acc-tabs, .acc-row, .acc-oauth { height: 3; margin: 0 1; }
.acc-tab { width: 1fr; background: #16161c; border: none; color: #9a9aa6; }
.acc-tab.-active { background: #2a1a14; color: #ff8a5c; text-style: bold; }
.acc-label { height: 1; margin-top: 1; }
#account-body Input { margin: 0 1; }
.acc-wide { width: 100%; margin: 1 1 0 1; }
.acc-oauth-btn { width: 1fr; margin-right: 1; }
.acc-row Button { margin-right: 1; }
#account-body .acc-row Input { width: 1fr; margin: 0 1 0 0; }
.acc-preset { min-width: 10; }
.acc-preset.-active { background: #2a1a14; color: #ff8a5c; text-style: bold; }
.acc-footer { margin-top: 1; }
#acc-strength { height: 1; }
#header-account { width: auto; padding-right: 3; }

/* project actions in the side panel */
.activity-open { width: 100%; margin: 1 1 0 1; }
.activity-actions { height: 1; margin: 0 0 0 1; }
.activity-btn { min-width: 0; width: auto; height: 1; border: none; padding: 0 1; margin-right: 1; background: #16161c; color: #9a9aa6; }
.activity-btn:hover { background: #2a1a14; color: #ff8a5c; }
.activity-btn-close:hover { background: #3a1416; color: #f47067; }
.activity-recent-head { margin-top: 1; }
#activity-recent { height: auto; max-height: 16; border: none; background: transparent; padding: 0; }
.activity-tip { height: auto; }
