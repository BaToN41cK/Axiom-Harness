# YooKassa credentials for the owner's server.
#
# Copy to `.env` and fill in real values. `.env` is gitignored: the secret key is
# full authority over the shop, so it must never be committed — this applies to a
# test key too, which grants access to the test shop.
#
# Shop id and secret key: ЮKassa personal account → Настройки → Магазин.
AXIOM_YOOKASSA_SHOP_ID=
AXIOM_YOOKASSA_SECRET_KEY=

# An https page you control. YooKassa returns the payer here after the redirect
# flow, so it cannot point at the desktop client.
AXIOM_YOOKASSA_RETURN_URL=https://example.com/payment/return

# Shown to the payer and in the ЮKassa dashboard. Up to 128 characters.
AXIOM_YOOKASSA_DESCRIPTION=Пополнение баланса AXIOM
